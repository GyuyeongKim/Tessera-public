    <developer>
      <id>GyuyeongKim</id>
      <name>Gyuyeong Kim</name>
      <email>skycrawlers2@gmail.com</email>
      <url>https://github.com/GyuyeongKim</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/GyuyeongKim/Tessera-public.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/GyuyeongKim/Tessera-public.git</developerConnection>
