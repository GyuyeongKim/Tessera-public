COPY (SELECT CASE WHEN i < 300000 THEN i ELSE hash(i) % 5000 END::BIGINT AS k, CASE WHEN i < 300000 THEN 0 ELSE 1 + i % 300 END AS x FROM range(900000) t(i) ORDER BY x) TO '{TEST_DIR}/big_grow_by_x.parquet' (FORMAT parquet);

statement ok
