statement ok
COPY (SELECT CAST(hash(i) % 6000 AS BIGINT) AS k, i % 300 AS x FROM range(600000) t(i)) TO '{TEST_DIR}/big_grow.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM '{TEST_DIR}/big_grow.parquet' ORDER BY k) TO '{TEST_DIR}/big_grow_sorted.parquet' (FORMAT parquet);

statement ok
