require tessera

require parquet

statement ok
COPY (SELECT i % 40 AS k, (i * 7) % 200 AS x, i % 3 AS c FROM range(20000) t(i)) TO '{TEST_DIR}/grow.parquet' (FORMAT parquet);

statement ok
COPY (SELECT i AS k, i % 50 AS x, i % 3 AS c FROM range(20000) t(i)) TO '{TEST_DIR}/flat.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM '{TEST_DIR}/grow.parquet') TO '{TEST_DIR}/grow.csv' (HEADER);

statement ok
