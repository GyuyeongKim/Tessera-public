statement ok
CREATE MACRO queries27measured() AS TABLE
  SELECT 'grow_pq' AS q, a.x AS i, b.x AS j, COUNT(*)::HUGEINT AS s FROM '{TEST_DIR}/grow.parquet' a JOIN '{TEST_DIR}/grow.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'grow_csv', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/grow.csv' a JOIN '{TEST_DIR}/grow.csv' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'grow_mix', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/grow.csv' a JOIN '{TEST_DIR}/grow.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'grow_filter', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/grow.parquet' a JOIN '{TEST_DIR}/grow.parquet' b ON a.k = b.k WHERE a.c = 1 AND b.x < 100 GROUP BY a.x, b.x
  UNION ALL SELECT 'grow_key2', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/grow.parquet' a JOIN '{TEST_DIR}/grow.parquet' b ON a.k = b.k AND a.c = b.c GROUP BY a.x, b.x
  UNION ALL SELECT 'grow_rejects', a.x, b.x, COUNT(*) FROM read_csv('{TEST_DIR}/grow.csv', store_rejects = true) a JOIN '{TEST_DIR}/grow.csv' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'flat_pq', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/flat.parquet' a JOIN '{TEST_DIR}/flat.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'big_grow', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/big_grow.parquet' a JOIN '{TEST_DIR}/big_grow_sorted.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'big_flat', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/big_flat_sorted.parquet' a JOIN '{TEST_DIR}/big_flat.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'by_x', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/big_grow_by_x.parquet' a JOIN '{TEST_DIR}/big_grow_by_x.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'by_x_groups', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/big_grow_by_x_groups.parquet' a JOIN '{TEST_DIR}/big_grow_by_x.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'one_group', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/one_group.parquet' a JOIN '{TEST_DIR}/one_group.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'set', a.x, b.x, COUNT(*) FROM '{TEST_DIR}/set1_*.parquet' a JOIN '{TEST_DIR}/set1_*.parquet' b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL (WITH r AS MATERIALIZED (SELECT k, x FROM '{TEST_DIR}/big_grow_by_x.parquet') SELECT 'cte', a.x, b.x, COUNT(*) FROM r a JOIN r b ON a.k = b.k GROUP BY a.x, b.x)
  UNION ALL (WITH r(p, q) AS MATERIALIZED (SELECT x, k FROM '{TEST_DIR}/big_grow_by_x.parquet') SELECT 'cte_names', a.p, b.p, COUNT(*) FROM r a JOIN r b ON a.q = b.q GROUP BY a.p, b.p);

statement ok
CREATE TABLE with_rule27measured AS SELECT * FROM queries27measured();

statement ok
SET tessera_enabled = false;

statement ok
CREATE TABLE without_rule27measured AS SELECT * FROM queries27measured();

statement ok
SET tessera_enabled = true;

query I
SELECT count(*) FROM ((SELECT * FROM with_rule27measured EXCEPT ALL SELECT * FROM without_rule27measured) UNION ALL (SELECT * FROM without_rule27measured EXCEPT ALL SELECT * FROM with_rule27measured));
----
0

query I
SELECT count(*) > 0 FROM with_rule27measured WHERE q = 'big_flat';
----
true
