statement ok
COPY (SELECT CAST(hash(i) % 50000 AS BIGINT) AS k, i % 300 AS x FROM range(1000000) t(i)) TO '{TEST_DIR}/scaled.parquet' (FORMAT parquet);

query II
EXPLAIN WITH r AS MATERIALIZED (SELECT k, x FROM '{TEST_DIR}/scaled.parquet') SELECT * FROM (SELECT a.x AS i, b.x AS j, COUNT(*) AS c FROM r a JOIN r b ON a.k = b.k GROUP BY a.x, b.x) p JOIN (SELECT a.x AS i, b.x AS j, COUNT(*) AS c FROM r a JOIN r b ON a.k = b.k GROUP BY a.x, b.x) q ON p.i = q.i AND p.j = q.j;
----
physical_plan	<REGEX>:.*(TESSERA|Tessera).*(TESSERA|Tessera).*

query II
EXPLAIN SELECT a.x, b.x, COUNT(*) FROM '{TEST_DIR}/scaled.parquet' a JOIN '{TEST_DIR}/scaled.parquet' b ON a.k = b.k GROUP BY a.x, b.x HAVING COUNT(*) > 2000 ORDER BY 3 DESC LIMIT 5;
----
physical_plan	<REGEX>:.*(TESSERA|Tessera).*

