require tessera

statement ok
SET tessera_min_expansion = 0;

statement ok
SET tessera_min_expansion_cross = 0;

statement ok
SET tessera_min_expansion_measured = 0;

statement ok
CREATE TABLE r AS SELECT (hash(i) % 300)::BIGINT AS k, (hash(i * 7) % 40)::BIGINT AS x,
  CASE WHEN hash(i * 7) % 40 = 7 OR hash(i * 3) % 4 = 0 THEN NULL WHEN hash(i * 29) % 97 = 0 THEN 'inf'::DOUBLE
       ELSE (1 + hash(i * 5) % 5)::DOUBLE END AS v,
  CASE WHEN hash(i * 11) % 5 = 0 THEN NULL ELSE (hash(i * 13) % 7)::BIGINT END AS iv,
  CASE WHEN hash(i * 31) % 6 = 0 THEN NULL ELSE (hash(i * 37) % 9)::BIGINT END AS xn,
  'item-' || (hash(i * 7) % 40) AS xs,
  CASE WHEN hash(i * 41) % 3 = 0 THEN NULL WHEN hash(i * 43) % 50 = 0 THEN 2000000000 ELSE 3 END::INTEGER AS big
  FROM range(6000) t(i);

statement ok
CREATE TABLE s AS SELECT (hash(i + 1) % 300)::BIGINT AS k, (hash(i * 17) % 30)::BIGINT AS y,
  CASE WHEN hash(i * 19) % 3 = 0 THEN NULL ELSE (1 + hash(i * 23) % 4)::DOUBLE END AS w,
  CASE WHEN hash(i * 47) % 4 = 0 THEN NULL ELSE (hash(i * 53) % 11)::BIGINT END AS jw,
  CASE WHEN hash(i * 59) % 2 = 0 THEN NULL ELSE 2 END::INTEGER AS big
  FROM range(4000) t(i);

statement ok
COPY r TO '{TEST_DIR}/nulls_r.csv' (HEADER);

query II
EXPLAIN SELECT a.x, b.y, SUM(a.v * b.w) AS s FROM r a JOIN s b ON a.k = b.k GROUP BY a.x, b.y;
----
physical_plan	<REGEX>:.*(TESSERA|Tessera).*

statement ok
CREATE TABLE on_sum AS SELECT a.x, b.y, SUM(a.v * b.w) AS s FROM r a JOIN s b ON a.k = b.k GROUP BY a.x, b.y;

statement ok
SET tessera_enabled = false;

statement ok
CREATE TABLE off_sum AS SELECT a.x, b.y, SUM(a.v * b.w) AS s FROM r a JOIN s b ON a.k = b.k GROUP BY a.x, b.y;

statement ok
SET tessera_enabled = true;

query I
SELECT count(*) FROM ((SELECT * FROM on_sum EXCEPT ALL SELECT * FROM off_sum) UNION ALL (SELECT * FROM off_sum EXCEPT ALL SELECT * FROM on_sum));
----
0

query I
SELECT count(*) > 0 FROM on_sum WHERE s IS NULL;
----
true

