CREATE MACRO queries27() AS TABLE
  SELECT 'ne' AS q, a.x::VARCHAR AS i, b.x::VARCHAR AS j, COUNT(*)::HUGEINT AS s FROM f a, f b WHERE a.k = b.k AND a.x <> b.x GROUP BY a.x, b.x
  UNION ALL SELECT 'distinct', a.x::VARCHAR, b.x::VARCHAR, COUNT(DISTINCT a.k) FROM f a, f b WHERE a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'offset', * FROM (SELECT a.x::VARCHAR, b.x::VARCHAR, COUNT(*) AS s FROM f a, f b WHERE a.k = b.k AND a.x < b.x GROUP BY a.x, b.x ORDER BY s DESC, 1, 2 LIMIT 5 OFFSET 3)
  UNION ALL SELECT 'one_side', a.x::VARCHAR, b.x::VARCHAR, COUNT(*) FROM f a, f b WHERE a.k = b.k AND a.c = 1 GROUP BY a.x, b.x
  UNION ALL SELECT 'key2', a.x::VARCHAR, b.x::VARCHAR, SUM(a.v * b.v) FROM f a, f b WHERE a.k = b.k AND a.k2 = b.k2 GROUP BY a.x, b.x
  UNION ALL SELECT 'group3', a.c || '|' || a.x, b.x::VARCHAR, COUNT(*) FROM f a, f b WHERE a.k = b.k AND a.x < b.x GROUP BY a.c, a.x, b.x
  UNION ALL SELECT 'sum_one', a.x::VARCHAR, b.x::VARCHAR, SUM(a.v) FROM f a, f b WHERE a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'date', a.dt::VARCHAR, b.dt::VARCHAR, COUNT(*) FROM f a, f b WHERE a.k = b.k AND a.dt < b.dt GROUP BY a.dt, b.dt
  UNION ALL SELECT 'decimal', a.x::VARCHAR, b.x::VARCHAR, CAST(SUM(a.pr * b.pr) * 10000 AS HUGEINT) FROM f a, f b WHERE a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'two', a.x::VARCHAR, b.x::VARCHAR || '|' || SUM(a.v * b.v), COUNT(*) FROM f a, f b WHERE a.k = b.k GROUP BY a.x, b.x;

