  UNION ALL SELECT 'cross_y', i, j, c FROM (SELECT a.x i, b.y j, COUNT(*) c, RANK() OVER (PARTITION BY b.y ORDER BY COUNT(*) DESC) r FROM rk a JOIN rs b ON a.k = b.k GROUP BY a.x, b.y) WHERE r <= 3
  UNION ALL SELECT 'cross_sum', i, j, c FROM (SELECT a.x i, b.y j, SUM(a.v * b.w) c, RANK() OVER (PARTITION BY b.y ORDER BY SUM(a.v * b.w) DESC) r FROM rk a JOIN rs b ON a.k = b.k GROUP BY a.x, b.y) WHERE r <= 3
  UNION ALL SELECT 'tuple', i, j, c FROM (SELECT a.x + 1000 * a.c i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.c, a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.c, a.x, b.x) WHERE r <= 3
  UNION ALL SELECT 'null_group', coalesce(i, -1), j, c FROM (SELECT a.xn i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.xn ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.xn, b.x) WHERE r <= 3
  UNION ALL SELECT 'string', hash(i) % 1000000, hash(j) % 1000000, c FROM (SELECT a.s i, b.s j, COUNT(*) c, RANK() OVER (PARTITION BY a.s ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.s, b.s) WHERE r <= 3
  UNION ALL SELECT 'str_lt', hash(i) % 1000000, hash(j) % 1000000, c FROM (SELECT a.s i, b.s j, COUNT(*) c, RANK() OVER (PARTITION BY b.s ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k AND a.s < b.s GROUP BY a.s, b.s) WHERE r <= 3
