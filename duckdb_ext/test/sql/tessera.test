CREATE MACRO queries27avg() AS TABLE
  SELECT 'avg' AS q, a.x AS i, b.x AS j, AVG(a.v * b.v) AS s, NULL::BIGINT AS c, NULL::HUGEINT AS t FROM f a, f b
    WHERE a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'avg_dec', a.x, b.x, AVG(a.pr * b.pr), NULL, NULL FROM f a, f b WHERE a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'avg_one', a.x, b.x, AVG(a.v), NULL, NULL FROM f a, f b WHERE a.k = b.k AND a.c = 1 GROUP BY a.x, b.x
  UNION ALL SELECT 'avg_three', a.x, b.x, AVG(a.v * b.v), COUNT(*), SUM(a.v * b.v) FROM f a, f b WHERE a.k = b.k AND a.x < b.x
    GROUP BY a.x, b.x;

