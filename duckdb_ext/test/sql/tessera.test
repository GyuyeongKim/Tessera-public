statement ok
CREATE MACRO rank27() AS TABLE
  SELECT 'rn_a' AS q, i, j, c::DOUBLE AS c FROM (SELECT a.x i, b.x j, COUNT(*) c, ROW_NUMBER() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC, b.x) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.x, b.x) WHERE r <= 7
  UNION ALL SELECT 'rn_b', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, ROW_NUMBER() OVER (PARTITION BY b.x ORDER BY COUNT(*) DESC, a.x) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.x, b.x) WHERE r <= 7
  UNION ALL SELECT 'rank', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.x, b.x) WHERE r <= 3
  UNION ALL SELECT 'lt_op', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.x, b.x) WHERE r < 4
  UNION ALL SELECT 'eq_one', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.x, b.x) WHERE r = 1
  UNION ALL SELECT 'flip', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.x, b.x) WHERE 3 >= r
  UNION ALL SELECT 'between', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, ROW_NUMBER() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC, b.x) r FROM rk a JOIN rk b ON a.k = b.k GROUP BY a.x, b.x) WHERE r BETWEEN 3 AND 5
  UNION ALL SELECT 'lt_a', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k AND a.x < b.x GROUP BY a.x, b.x) WHERE r <= 3
  UNION ALL SELECT 'lt_b', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY b.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k AND a.x < b.x GROUP BY a.x, b.x) WHERE r <= 3
  UNION ALL SELECT 'gt_a', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k AND a.x > b.x GROUP BY a.x, b.x) WHERE r <= 3
  UNION ALL SELECT 'gt_b', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY b.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k AND a.x > b.x GROUP BY a.x, b.x) WHERE r <= 3
  UNION ALL SELECT 'le_a', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k AND a.x <= b.x GROUP BY a.x, b.x) WHERE r <= 3
  UNION ALL SELECT 'ge_b', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY b.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k AND a.x >= b.x GROUP BY a.x, b.x) WHERE r <= 3
  UNION ALL SELECT 'ne_a', i, j, c FROM (SELECT a.x i, b.x j, COUNT(*) c, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) r FROM rk a JOIN rk b ON a.k = b.k AND a.x <> b.x GROUP BY a.x, b.x) WHERE r <= 3
