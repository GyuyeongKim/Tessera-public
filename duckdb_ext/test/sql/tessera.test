statement ok
CREATE TABLE r AS SELECT i % 50 AS k, i % 9 AS x, i * 1000003 - 2500000000 AS v FROM range(3000) r(i);

statement ok
CREATE TABLE r2 AS SELECT i % 50 AS k, i % 11 AS y, 3000000000 - i * 999983 AS w FROM range(2000) r(i);

statement ok
CREATE MACRO queries() AS TABLE
  SELECT 'full' AS q, a.x::VARCHAR AS i, b.x::VARCHAR AS j, COUNT(*)::HUGEINT AS s FROM t a, t b WHERE a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'lt', a.x::VARCHAR, b.x::VARCHAR, COUNT(*) FROM t a, t b WHERE a.k = b.k AND a.x < b.x GROUP BY a.x, b.x
  UNION ALL SELECT 'le', a.x::VARCHAR, b.x::VARCHAR, COUNT(*) FROM t a, t b WHERE a.k = b.k AND a.x <= b.x GROUP BY a.x, b.x
  UNION ALL SELECT 'gt', a.x::VARCHAR, b.x::VARCHAR, COUNT(*) FROM t a, t b WHERE a.k = b.k AND a.x > b.x GROUP BY a.x, b.x
  UNION ALL SELECT 'sum', a.x::VARCHAR, b.x::VARCHAR, SUM(a.v * b.v) FROM t a, t b WHERE a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'str', a.x, b.x, SUM(a.v * b.v) FROM s a, s b WHERE a.k = b.k AND a.x < b.x GROUP BY a.x, b.x
  UNION ALL SELECT 'cross', a.x::VARCHAR, b.y::VARCHAR, SUM(a.v * b.w) FROM r a, r2 b WHERE a.k = b.k GROUP BY a.x, b.y
  UNION ALL SELECT 'having', a.x, b.x, SUM(a.v * b.v) FROM s a, s b WHERE a.k = b.k AND a.x < b.x GROUP BY a.x, b.x HAVING SUM(a.v * b.v) >= 1000000
  UNION ALL SELECT 'topk', * FROM (SELECT a.x, b.x, SUM(a.v * b.v) AS s FROM s a, s b WHERE a.k = b.k AND a.x < b.x GROUP BY a.x, b.x ORDER BY s DESC, a.x, b.x LIMIT 10);

statement ok
CREATE TABLE with_rule AS SELECT * FROM queries();

