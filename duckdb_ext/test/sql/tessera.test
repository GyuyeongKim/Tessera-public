CREATE TABLE rk AS SELECT (hash(i) % 700)::BIGINT AS k, floor(power(hash(i + 1) / 18446744073709551616.0, 2) * 500)::BIGINT AS x,
  'v' || (hash(i + 2) % 90) AS s, (hash(i + 3) % 4)::BIGINT AS c, (hash(i + 4) % 31)::BIGINT - 15 AS v,
  CASE WHEN i % 2003 = 0 THEN 'NaN'::DOUBLE ELSE (hash(i + 5) % 1000) / 100.0 END AS d,
  CASE WHEN i % 11 = 0 THEN NULL ELSE (hash(i + 6) % 60)::BIGINT END AS xn,
  ((hash(i + 7) % 9)::BIGINT + 1) * 1000000000000000 AS h FROM range(30000) t(i);

