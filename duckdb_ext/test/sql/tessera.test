CREATE TABLE ms AS SELECT (hash(i) % 900)::BIGINT AS k, floor(power(hash(i + 1) / 18446744073709551616.0, 2) * 400)::BIGINT AS x,
  1 + (hash(i + 2) % 5)::DOUBLE AS r, (hash(i + 3) % 21)::BIGINT - 10 AS v, 1 + (hash(i + 4) % 9)::INTEGER AS n, 'g' || (hash(i + 5) % 40) AS s FROM range(40000) t(i);

statement ok
CREATE TABLE mt AS SELECT (hash(i + 6) % 900)::BIGINT AS k, (hash(i + 7) % 150)::BIGINT AS y, 1 + (hash(i + 8) % 3)::DOUBLE AS r, (hash(i + 9) % 7)::BIGINT AS w FROM range(12000) t(i);

