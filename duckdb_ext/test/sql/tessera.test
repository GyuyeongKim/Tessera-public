  UNION ALL SELECT 'avg_one', a.x, b.x, AVG(a.v), NULL, NULL FROM f a, f b WHERE a.k = b.k AND a.c = 1 GROUP BY a.x, b.x
  UNION ALL SELECT 'avg_three', a.x, b.x, AVG(a.v * b.v), COUNT(*), SUM(a.v * b.v) FROM f a, f b WHERE a.k = b.k AND a.x < b.x
    GROUP BY a.x, b.x;

