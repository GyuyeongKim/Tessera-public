CREATE TABLE fn AS SELECT k, x, c, k2, v, CASE WHEN x % 5 = 0 THEN NULL ELSE x END AS nx FROM f;

statement ok
CREATE MACRO queries27null() AS TABLE
  SELECT 'null' AS q, a.nx::VARCHAR AS i, b.x::VARCHAR AS j, COUNT(*)::HUGEINT AS s FROM fn a, fn b WHERE a.k = b.k
    GROUP BY a.nx, b.x
  UNION ALL SELECT 'null_lt', a.nx::VARCHAR, b.nx::VARCHAR, COUNT(*) FROM fn a, fn b WHERE a.k = b.k AND a.nx < b.nx
    GROUP BY a.nx, b.nx
  UNION ALL SELECT 'null_distinct', a.nx::VARCHAR, b.nx::VARCHAR, SUM(a.v * b.v) FROM fn a, fn b
    WHERE a.k = b.k AND a.nx IS DISTINCT FROM b.nx GROUP BY a.nx, b.nx
  UNION ALL SELECT 'expr_mod', (a.x % 4)::VARCHAR, b.x::VARCHAR, COUNT(*) FROM fn a, fn b WHERE a.k = b.k
    GROUP BY a.x % 4, b.x
  UNION ALL SELECT 'expr_concat', a.c || '-' || a.k2, (b.x // 3)::VARCHAR, COUNT(*) FROM fn a, fn b WHERE a.k = b.k
    GROUP BY a.c || '-' || a.k2, b.x // 3;

