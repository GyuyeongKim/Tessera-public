CREATE TABLE fw AS SELECT k, c, x::TINYINT AS xt, x::INTEGER AS xi, (x::BIGINT - 8) * 1000003 AS xb, x::UINTEGER AS xu FROM f;

statement ok
CREATE MACRO queries27wide() AS TABLE
  SELECT 'big_lt_int' AS q, a.xb AS i, b.xi AS j, COUNT(*)::HUGEINT AS s FROM fw a JOIN fw b ON a.k = b.k AND a.xb < b.xi GROUP BY a.xb, b.xi
  UNION ALL SELECT 'int_ge_big', a.xi, b.xb, COUNT(*) FROM fw a JOIN fw b ON a.k = b.k AND a.xi >= b.xb GROUP BY a.xi, b.xb
  UNION ALL SELECT 'tiny_ne_big', a.xt, b.xb, COUNT(*) FROM fw a JOIN fw b ON a.k = b.k AND a.xt <> b.xb GROUP BY a.xt, b.xb
  UNION ALL SELECT 'uint_lt_int', a.xu, b.xi, COUNT(*) FROM fw a JOIN fw b ON a.k = b.k AND a.xu < b.xi GROUP BY a.xu, b.xi
  UNION ALL SELECT 'tuple', a.xb, b.xi, COUNT(*) FROM fw a JOIN fw b ON a.k = b.k AND a.xb > b.xi GROUP BY a.c, a.xb, b.xi;

statement ok
