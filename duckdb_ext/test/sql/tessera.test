CREATE MACRO many27() AS TABLE
  SELECT 'cosine' AS q, a.x AS i, b.x AS j, round(SUM(a.r * b.r) / (SQRT(SUM(a.r * a.r)) * SQRT(SUM(b.r * b.r))), 6)::DOUBLE AS v0, NULL::DOUBLE AS v1, NULL::DOUBLE AS v2 FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'three', a.x, b.x, round(SUM(a.r * b.r), 6), round(SUM(a.r * a.r), 6), round(SUM(b.r * b.r), 6) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'count_first', a.x, b.x, COUNT(*), round(SUM(a.r * b.r), 6), round(SUM(a.r), 6) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'count_last', a.x, b.x, round(SUM(a.r), 6), round(SUM(b.r), 6), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'pearson', a.x, b.x, round((COUNT(*) * SUM(a.r * b.r) - SUM(a.r) * SUM(b.r)) / NULLIF(SQRT((COUNT(*) * SUM(a.r * a.r) - SUM(a.r) * SUM(a.r)) * (COUNT(*) * SUM(b.r * b.r) - SUM(b.r) * SUM(b.r))), 0), 5), NULL, NULL FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'ints', a.x, b.x, SUM(a.v * b.v), SUM(a.v), SUM(b.n) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'int_int32', a.x, b.x, SUM(a.n * b.n), SUM(a.n), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'mixed', a.x, b.x, round(SUM(a.r * b.r), 6), SUM(a.v * b.v), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'lt', a.x, b.x, round(SUM(a.r * b.r), 6), round(SUM(a.r * a.r), 6), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k AND a.x < b.x GROUP BY a.x, b.x
  UNION ALL SELECT 'ne', a.x, b.x, round(SUM(a.r * b.r), 6), round(SUM(b.r * b.r), 6), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k AND a.x <> b.x GROUP BY a.x, b.x
  UNION ALL SELECT 'having', a.x, b.x, COUNT(*), round(SUM(a.r * b.r), 6), round(SUM(a.r * a.r), 6) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x HAVING COUNT(*) >= 50
  UNION ALL SELECT 'having_sum', a.x, b.x, round(SUM(a.r * b.r), 6), round(SUM(a.r * a.r), 6), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x HAVING SUM(a.r * b.r) >= 200
  UNION ALL SELECT 'where', a.x, b.x, round(SUM(a.r * b.r), 6), round(SUM(a.r * a.r), 6), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k WHERE a.n > 3 AND b.r < 5 GROUP BY a.x, b.x
  UNION ALL SELECT 'two_rel', a.x, b.y, round(SUM(a.r * b.r), 6), round(SUM(a.r * a.r), 6), SUM(a.v * b.w) FROM ms a JOIN mt b ON a.k = b.k GROUP BY a.x, b.y
  UNION ALL SELECT 'cast', a.x, b.y, round(SUM(a.v * b.r), 6), round(SUM(a.n * b.r), 6), COUNT(*) FROM ms a JOIN mt b ON a.k = b.k GROUP BY a.x, b.y
  UNION ALL SELECT 'triple', a.x, b.x, round(SUM(a.r * a.r * b.r), 6), round(SUM(a.r * b.r * b.r), 6), round(SUM(a.r * b.r), 6) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'strings', hash(a.s) % 1000000, hash(b.s) % 1000000, round(SUM(a.r * b.r), 6), round(SUM(a.r), 6), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.s, b.s
  UNION ALL SELECT 'tuple', a.x, b.x + 1000 * a.n, round(SUM(a.r * b.r), 6), round(SUM(a.r), 6), COUNT(*) FROM ms a JOIN ms b ON a.k = b.k GROUP BY a.n, a.x, b.x
