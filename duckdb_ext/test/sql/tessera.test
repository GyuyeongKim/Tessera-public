----
physical_plan	<REGEX>:.*Prune: >= 2.*

query II
EXPLAIN SELECT a.x, b.x, COUNT(*) AS c FROM rv27 a JOIN rv27 b ON a.k = b.k GROUP BY a.x, b.x ORDER BY c DESC LIMIT 3;
----
physical_plan	<REGEX>:.*Prune: top 3.*

query II
EXPLAIN SELECT x, y, n FROM (SELECT a.x AS x, b.x AS y, ROW_NUMBER() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC, b.x) AS n FROM rv27 a JOIN rv27 b ON a.k = b.k GROUP BY a.x, b.x) WHERE n <= 2;
----
physical_plan	<REGEX>:.*Prune: rank <= 2.*

query II
EXPLAIN SELECT x, y, n FROM (SELECT a.x AS x, b.x AS y, RANK() OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) AS n FROM rv27 a JOIN rv27 b ON a.k = b.k GROUP BY a.x, b.x) WHERE n <= 2;
----
physical_plan	<REGEX>:.*Prune: rank <= 2.*

query II
EXPLAIN SELECT x, y, n FROM (SELECT a.x AS x, b.x AS y, ROW_NUMBER(ORDER BY b.x) OVER (PARTITION BY a.x ORDER BY COUNT(*) DESC) AS n FROM rv27 a JOIN rv27 b ON a.k = b.k GROUP BY a.x, b.x) WHERE n <= 1;
----
physical_plan	<!REGEX>:.*Prune.*
