CREATE MACRO queries27opaque() AS TABLE
  SELECT 'distinct' AS q, a.x AS i, b.x AS j, COUNT(*)::HUGEINT AS s FROM (SELECT DISTINCT k, x FROM f) a JOIN f b
    ON a.k = b.k GROUP BY a.x, b.x
  UNION ALL SELECT 'aggregate', a.x, b.x, COUNT(*) FROM (SELECT k, x, COUNT(*) AS n FROM f GROUP BY k, x HAVING n > 1) a
    JOIN f b ON a.k = b.k AND a.x < b.x GROUP BY a.x, b.x
  UNION ALL SELECT 'three', a.x, c.x, COUNT(*) FROM f a JOIN f b ON a.k = b.k JOIN fn c ON b.k2 = c.k2 GROUP BY a.x, c.x;

